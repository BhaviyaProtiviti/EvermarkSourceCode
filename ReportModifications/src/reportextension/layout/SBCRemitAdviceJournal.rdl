                      <CellContents>
                        <Textbox Name="Group1">
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Cstr(Fields!CompAddr1.Value) + Chr(177) + 
Cstr(Fields!CompAddr2.Value) + Chr(177) + 
Cstr(Fields!CompAddr3.Value) + Chr(177) + 
Cstr(Fields!CompAddr4.Value) + Chr(177) + 
Cstr(Fields!CompAddr5.Value) + Chr(177) + 
Cstr(Fields!DocNo_GenJnlLine.Value) + Chr(177) + 
Cstr(Fields!AccNo_GenJournalLine.Value) + Chr(177) + 
Cstr(Fields!SBCVendBankAcctAddress_1.Value) + Chr(177) +
Cstr(Fields!SBCVendBankAcctAddress_2.Value) + Chr(177) +
Cstr(Fields!SBCVendBankAcctAddress_3.Value) + Chr(177) +
Cstr(Fields!SBCVendBankAcctAddress_4.Value) + Chr(177) +
Cstr(Fields!SBCVendBankAcctAddress_5.Value) + Chr(177) +
Cstr(Sum(Fields!AppliedVendLedgEntryTempRemainingAmt.Value)) + Chr(177) + 
Cstr(Sum(Fields!PmdDiscRec.Value)) + Chr(177) + 
Cstr(Sum(Fields!TotalAmount.Value)) + Chr(177) +
Cstr(Sum(Fields!PaidAmount.Value))</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Color>Red</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
