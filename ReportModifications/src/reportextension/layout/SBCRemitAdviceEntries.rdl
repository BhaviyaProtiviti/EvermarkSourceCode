                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Cstr(Fields!CompanyAddr1.Value) + Chr(177) + 
Cstr(Fields!CompanyAddr2.Value) + Chr(177) + 
Cstr(Fields!CompanyAddr3.Value) + Chr(177) + 
Cstr(Fields!CompanyAddr4.Value) + Chr(177) + 
Cstr(Fields!CompanyAddr5.Value) + Chr(177) + 
Cstr(Fields!DocNo_VendLedgEntry.Value) + Chr(177) + 
Cstr(Fields!VendorLedgerEntryVendorNo.Value) + Chr(177) + 
Cstr(Fields!SBCVendBankAcctAddress_1.Value) + Chr(177) +
