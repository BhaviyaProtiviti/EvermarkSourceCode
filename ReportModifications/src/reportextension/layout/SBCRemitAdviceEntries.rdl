Cstr(Sum(Fields!RemAmt_VendLedgEntry2.Value)) + Chr(177) + 
Cstr(Sum(Fields!LineDiscount_VendLedgEntry2.Value)) + Chr(177) + 
Cstr(-Sum(Fields!LAmountWDiscCur.Value)) + Chr(177) + 
Cstr(Fields!SBCPostingDate.Value)</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <Color>Red</Color>
                                  </Style>
